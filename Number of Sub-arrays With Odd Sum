class Solution {
    public int numOfSubarrays(int[] arr) {
        int MOD = 1_000_000_007;
        long count = 0;
        int prefixSum = 0;
        int oddCount = 0;
        int evenCount = 1; // The initial prefix sum of 0 is even

        for (int num : arr) {
            prefixSum += num;
            if (prefixSum % 2 == 0) {
                count += oddCount;
                evenCount++;
            } else {
                count += evenCount;
                oddCount++;
            }
            count %= MOD;
        }

        return (int) count;
    }
}
